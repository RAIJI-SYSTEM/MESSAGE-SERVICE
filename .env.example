# Copie para .env ao rodar o chat FORA do Docker (bun dev).
# Dentro do docker-compose do monolith essas variáveis já são definidas lá.

PORT=3000
MONGODB_URI=mongodb://localhost:27017/raiji

# Issuer = URL pública do Kong (KC_HOSTNAME do Keycloak no monolith)
KEYCLOAK_ISSUER=http://localhost:8000/realms/raiji
# JWKS: via Kong quando o chat roda no host; http://keycloak:8080/... dentro do compose
KEYCLOAK_JWKS_URL=http://localhost:8000/realms/raiji/protocol/openid-connect/certs
# Sincronização de usuários (Keycloak -> RabbitMQ). Vazio = desativada.
RABBITMQ_URI=amqp://raiji:raiji123@localhost:5672
RABBITMQ_USERS_EXCHANGE=raiji.users

# Mídia do chat. Vazio = só texto (anexos respondem 503).
# Local (RustFS do compose do monolith, acessado pelo Kong):
S3_BUCKET=raiji-media
AWS_REGION=us-east-1
S3_ENDPOINT=http://localhost:8000
S3_PUBLIC_ENDPOINT=http://localhost:8000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=raiji
AWS_SECRET_ACCESS_KEY=raiji12345
# Produção (S3 da AWS): só S3_BUCKET e AWS_REGION — sem endpoints e sem chaves.

# Opcional: exige este "aud" no token (precisa de audience mapper no Keycloak)
KEYCLOAK_AUDIENCE=
