{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/modules/messages/attachment-rules.ts",
    "src/modules/messages/message-events.ts",
    "src/modules/rides/ride-events.ts",
    "src/modules/users/user-events.ts",
    "src/shared/errors.ts",
    "src/shared/schemas.ts"
  ],
  "coverageAnalysis": "perTest",
  "inPlace": true,
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 80
  },
  "concurrency": 4,
  "incremental": true,
  "ignorePatterns": [
    "load-tests/.venv/**",
    "tests/load/.venv/**",
    "coverage/**",
    "reports/**"
  ]
}
